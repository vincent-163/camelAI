{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "camelai-telegram-172a28c1",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "ALLOWED_CHAT_ID": "524019827",
    "GITHUB_OWNER": "vincent-163",
    "GITHUB_REPO": "camelAI",
    "GITHUB_BRANCH": "main",
    "AI_BASE_URL": "https://workers.v-163.top/ai/v1",
    "AI_MODEL": "gpt-5.6-sol"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TELEGRAM_SESSIONS",
        "class_name": "TelegramSession"
      },
      {
        "name": "TELEGRAM_ROUTER",
        "class_name": "TelegramRouter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TelegramSession", "TelegramRouter"]
    }
  ]
}
